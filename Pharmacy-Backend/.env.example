# Backend Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=3000

# Database (Neon/Postgres)
DATABASE_URL=postgresql://username:password@host:5432/dbname
# Set to 'true' to verify TLS certificates in production
DB_SSL_VERIFY=false

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_pass
BREVO_FROM_EMAIL=your_from_email@domain.com

# Pharmacy notification email
PHARMACY_EMAIL=pharmacy@yourdomain.com

# Resend (optional legacy)
RESEND_API_KEY=your_resend_api_key
